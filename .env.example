# TimeWorth — Environment Variables
# Copy this file to .env and fill in your Gemini API key.

# Google Gemini AI API key (Server-side only — never exposed to client)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model override (defaults to gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
